{
  "name": "qq-isolated-smoke",
  "application": "qq",
  "requirements": { "platform": "win32", "env": ["COMPUTER_USE_PLUS_QQ_COMMAND", "COMPUTER_USE_PLUS_QQ_WINDOW_PROCESS"] },
  "tasks": [
    {
      "id": "inspect-main-window",
      "strategy": "uia-ocr",
      "steps": [
        { "tool": "computer.execution", "arguments": { "action": "create" } },
        { "tool": "computer.execution", "arguments": { "action": "launch", "commandLine": "${COMPUTER_USE_PLUS_QQ_COMMAND}" } },
        { "tool": "computer.wait", "arguments": { "windowQuery": { "process": "${COMPUTER_USE_PLUS_QQ_WINDOW_PROCESS}" }, "timeoutMs": 30000, "pollMs": 250 }, "expect": { "minWindows": 1 } },
        { "tool": "computer.state", "arguments": { "scope": "all", "includeUi": true, "maxNodes": 30 }, "expect": { "minWindows": 1 } },
        { "tool": "computer.execution", "arguments": { "action": "diagnose" }, "expect": { "minWindows": 1 } }
      ]
    }
  ]
}
